<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.bwstatsapi</groupId>
    <artifactId>BWStatsAPI</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>
    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <repositories>
        <repository><id>spigot-repo</id><url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url></repository>
        <repository><id>jitpack.io</id><url>https://jitpack.io</url></repository>
        <repository><id>luckperms</id><url>https://oss.sonatype.org/content/repositories/snapshots/</url></repository>
    </repositories>
    <dependencies>
        <dependency><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId><version>1.8.8-R0.1-SNAPSHOT</version><scope>provided</scope></dependency>
        <dependency><groupId>com.github.andrei1058</groupId><artifactId>BedWars1058</artifactId><version>22.12</version><scope>provided</scope></dependency>
        <dependency><groupId>me.leoo.guilds</groupId><artifactId>Guilds</artifactId><version>2.0.8</version><scope>provided</scope></dependency>
        <dependency><groupId>me.infinity.groupstats</groupId><artifactId>GroupStats</artifactId><version>9.0-SNAPSHOT</version><scope>provided</scope></dependency>
        <dependency><groupId>net.luckperms</groupId><artifactId>LuckPerms</artifactId><version>5.4.151</version><scope>provided</scope></dependency>
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.42.0.0</version><scope>compile</scope></dependency>
    </dependencies>
    <build>
        <finalName>BWStatsAPI</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation><pattern>org.sqlite</pattern><shadedPattern>com.bwstatsapi.lib.sqlite</shadedPattern></relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
